PORT=5000
NODE_ENV=development
API_BASE_PATH=/api/v1
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
JWT_SECRET=YOUR_USER_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=YOUR_ADMIN_JWT_SECRET_DIFFERENT_FROM_USER_MIN_32_CHARS
ADMIN_JWT_EXPIRES_IN=8h
USER_SESSION_SECRET=YOUR_USER_SESSION_SECRET
ADMIN_SESSION_SECRET=YOUR_ADMIN_SESSION_SECRET
ADMIN_EMAIL=YOUR_INITIAL_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_INITIAL_ADMIN_PASSWORD
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLIENT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
SUPERADMIN_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
FAST2SMS_SENDER_ID=BUYINN
REDIS_URL=YOUR_REDIS_URL
COOKIE_DOMAIN=
COOKIE_SECURE=false
ENABLE_BACKGROUND_JOBS=true
